{
  "name": "sparkle",
  "version": "1.26.8",
  "description": "Sparkle",
  "main": "./out/main/index.js",
  "author": {
    "name": "xishang0128",
    "email": "xishang02@gmail.com"
  },
  "homepage": "https://github.com/xishang0128/sparkle",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "ensure:electron": "node scripts/install-electron.ts",
    "prepare": "node scripts/prepare.ts",
    "updater": "node scripts/updater.ts",
    "checksum": "node scripts/checksum.ts",
    "telegram": "node scripts/telegram.ts",
    "dev": "pnpm run ensure:electron && electron-vite dev",
    "postinstall": "pnpm run ensure:electron && electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --publish never --win",
    "build:mac": "electron-vite build && electron-builder --publish never --mac",
    "build:linux": "electron-vite build && node scripts/package-linux.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@uruhalushia/sparkle-native": "^0.1.2",
    "adm-zip": "^0.6.1",
    "age-encryption": "^0.3.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.3",
    "webdav": "^5.11.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@types/pubsub-js": "^1.8.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cron-validator": "^1.4.0",
    "driver.js": "^1.8.0",
    "electron": "^44.4.4",
    "electron-builder": "26.15.7",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "form-data": "^4.0.6",
    "framer-motion": "13.4.0",
    "is-cidr": "^7.0.1",
    "is-ip": "^5.0.1",
    "js-md5": "^0.9.2",
    "js-yaml": "^5.4.2",
    "lodash": "^4.18.1",
    "meta-json-schema": "^1.19.31",
    "monaco-editor": "^0.56.0",
    "monaco-yaml": "^5.5.1",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.8",
    "pubsub-js": "^1.9.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-aria": "3.52.1",
    "react-dom": "^19.3.0",
